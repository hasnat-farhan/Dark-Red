<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_background"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    tools:context=".MainActivity">


    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/top_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:elevation="2dp">


        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp">

            <ImageView
                android:id="@+id/appIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_bg"
                android:padding="0dp"
                android:scaleType="centerInside"
                android:src="@drawable/nearby"/>

            <View
                android:id="@+id/onlineIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/circle_bg"
                android:backgroundTint="#4CAF50"
                android:visibility="gone"
                android:elevation="2dp"/>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/titleContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="start"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:maxLength="19"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:singleLine="true"
                android:text="Nearby Chat"
                android:textColor="@color/title_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_gravity="end"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/downIcon"
                    android:layout_width="14dp"
                    android:layout_height="10dp"
                    android:paddingTop="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_down"
                    app:tint="@color/icon_tint" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="start"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/unseenMsg"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_round_unseen_msg"
                        android:gravity="center"
                        android:text="99+"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchOption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="start|center"
            android:paddingStart="6dp"
            android:paddingEnd="0dp"
            android:background="@drawable/bg_input_pill">

            <EditText
                android:id="@+id/inputSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_pill"
                android:gravity="start|center"
                android:hint="Search"
                android:textColorHint="@color/input_hint"
                android:imeOptions="actionSend"
                android:inputType="textNoSuggestions"
                android:singleLine="true"
                android:maxLines="1"
                android:textColor="@color/input_text"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/closeSearchOptionIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/close"
                android:padding="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="16dp"
                android:scaleType="centerInside"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/search"
            app:tint="@color/icon_tint" />

        <ImageView
            android:id="@+id/discoverIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|center_vertical"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/feed"
            app:tint="@color/primary_red" />

        <ImageView
            android:id="@+id/threeDotIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/dot3"
            app:tint="@color/icon_tint" />


    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <!-- Peer discovery panel (slides over chat when SOSBlue Mesh is active) -->
        <LinearLayout
            android:id="@+id/peerDiscoveryPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/peer_bar_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/peerPanelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearby Devices"
                android:textColor="@color/peer_bar_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/peerPanelSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOSBlue Mesh"
                android:textColor="@color/primary_red"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/peerRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/peerEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No peers discovered yet.\nTap the title to refresh."
                android:textColor="@color/peer_detail_text"
                android:textSize="14sp"
                android:gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/peerCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 peers online"
                android:textColor="@color/peer_detail_text"
                android:textSize="12sp"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/peerRefreshButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search again"
                android:textColor="@color/primary_red"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Initialising engine..."
            android:textColor="@color/icon_tint"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Transport mode selector (horizontal scroll → all three radios visible on narrow phones) -->
    <HorizontalScrollView
        android:id="@+id/transportScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <RadioGroup
            android:id="@+id/transportRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:checkedButton="@+id/rb_sosblue_mesh">

            <RadioButton
                android:id="@+id/rb_sosblue_mesh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOSBlue Mesh"
                android:textSize="12sp"
                android:textColor="@color/transport_text"
                android:buttonTint="@color/transport_button_tint"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_f2p_serverless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="F2P Serverless"
                android:textSize="12sp"
                android:textColor="@color/transport_text"
                android:buttonTint="@color/transport_button_tint"
                android:layout_marginStart="16dp" />

            <RadioButton
                android:id="@+id/rb_sms_fallback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/transport_sms"
                android:textSize="12sp"
                android:textColor="@color/transport_text"
                android:buttonTint="@color/transport_button_tint"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp" />

        </RadioGroup>

    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/replyPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/peer_bar_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="@color/primary_red"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textReplyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Replying to User"
                android:textColor="@color/bubble_incoming_text"
                android:textStyle="bold"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/textReplyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Message content..."
                android:textColor="@color/peer_detail_text"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/closeReplyButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:src="@drawable/close"
            app:tint="@color/icon_tint"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/input_bar_background"
        android:elevation="4dp"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="7dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/switchInputImage"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:src="@drawable/text"
                app:tint="@color/attachment_icon" />

        </LinearLayout>

        <EditText
            android:id="@+id/inputMessage"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_pill"
            android:gravity="bottom|start"
            android:hint="Type your message..."
            android:textColorHint="@color/input_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minLines="1"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/input_text"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/inputImageURL"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_pill"
            android:gravity="bottom|start"
            android:hint="Paste your image link here..."
            android:textColorHint="@color/input_hint"
            android:imeOptions="flagNoEnterAction"
            android:inputType="textMultiLine|textUri|textNoSuggestions"
            android:maxLines="4"
            android:minLines="1"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/input_text"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/inputVideoURL"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_pill"
            android:gravity="bottom|start"
            android:hint="Paste your video link here..."
            android:textColorHint="@color/input_hint"
            android:imeOptions="flagNoEnterAction"
            android:inputType="textMultiLine|textUri|textNoSuggestions"
            android:maxLines="4"
            android:minLines="1"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/input_text"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/sendButtonContainer"
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/sendButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/sent"
                android:scaleType="centerInside"
                android:background="@drawable/bg_send_button"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                app:tint="@color/white"/>

            <FrameLayout
                android:id="@+id/loadingContainer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:background="@drawable/loading_with_square" />

                <ProgressBar
                    android:id="@+id/sendProgressBar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminateTint="@color/primary_red" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="start"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chunkCount"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:background="@drawable/bg_round_chunk"
                android:gravity="center"
                android:text="999"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>