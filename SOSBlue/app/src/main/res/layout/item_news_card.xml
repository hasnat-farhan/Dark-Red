<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="2dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/peer_bar_bg"
    app:strokeColor="#333333"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Row 1: Author + Transport Badge + Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Author name -->
            <TextView
                android:id="@+id/newsAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Author Name"
                android:textColor="@color/title_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Transport badge (background tint set programmatically in adapter) -->
            <TextView
                android:id="@+id/newsTransportBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Mesh"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_round_unseen_msg"
                android:backgroundTint="#D32F2F" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/newsTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2m ago"
                android:textColor="@color/peer_detail_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Row 2: Text body -->
        <TextView
            android:id="@+id/newsTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="News broadcast text content goes here..."
            android:textColor="@color/input_text"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- Row 3: Media attachment indicator -->
        <ImageView
            android:id="@+id/newsMediaIndicator"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:visibility="gone"
            app:tint="@color/primary_red"
            android:contentDescription="Media attachment" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
