<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_background"
    android:fitsSystemWindows="false"
    android:orientation="vertical"
    tools:context=".ChatActivity">

    <!-- ============================================================
         Top App Bar — Search · RSS · Menu + "Nearby Devices" title
         ============================================================ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/top_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:elevation="2dp">

        <!-- App icon + online indicator -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/appIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_bg"
                android:scaleType="centerInside"
                android:src="@drawable/nearby" />

            <View
                android:id="@+id/onlineIndicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/circle_bg"
                android:backgroundTint="@color/online_green"
                android:elevation="2dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Title section: "Nearby Devices" + dropdown hint -->
        <LinearLayout
            android:id="@+id/titleContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Nearby Devices"
                android:textColor="@color/title_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/peerCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_round_unseen_msg"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingHorizontal="2dp"
                android:text="0"
                android:textColor="@color/badge_text"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Action icons -->
        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/search"
            android:tint="@color/icon_tint"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/discoverIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/feed"
            android:tint="@color/primary_red"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/threeDotIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/dot3"
            android:tint="@color/icon_tint"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- ============================================================
         Middle: Chat RecyclerView + overlay loading spinner
         ============================================================ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <!-- Full-screen progress for buffering/loading states -->
        <ProgressBar
            android:id="@+id/bufferingProgress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_red"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============================================================
         Dynamic Peer Bar — shows discovered nearby devices
         ============================================================ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/peerBarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/peer_bar_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/peerBarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nearby Devices"
                android:textColor="@color/peer_bar_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/peerBarRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============================================================
         Transport Selector Bar
         ============================================================ -->
    <RadioGroup
        android:id="@+id/transportRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:background="@color/chat_background"
        android:checkedButton="@+id/rb_sosblue_mesh">

        <RadioButton
            android:id="@+id/rb_sosblue_mesh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOSBlue Mesh"
            android:textSize="13sp"
            android:textColor="@color/transport_text"
            android:buttonTint="@color/transport_button_tint"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb_f2p_serverless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="F2P Serverless"
            android:textSize="13sp"
            android:textColor="@color/transport_text"
            android:buttonTint="@color/transport_button_tint"
            android:layout_marginStart="24dp" />
    </RadioGroup>

    <!-- ============================================================
         Recipient Phone Number — E2E encryption target
         ============================================================ -->
    <LinearLayout
        android:id="@+id/recipientContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:background="@color/chat_background">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/sent"
            android:scaleType="centerInside"
            android:tint="@color/recipient_icon_tint"
            android:layout_marginEnd="8dp"
            android:contentDescription="Encrypt" />

        <EditText
            android:id="@+id/inputRecipientPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_recipient_input"
            android:gravity="start|center_vertical"
            android:hint="@string/hint_recipient_phone"
            android:textColorHint="#666666"
            android:inputType="phone"
            android:singleLine="true"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="@color/recipient_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:contentDescription="Recipient phone number for end-to-end encryption" />

        <TextView
            android:id="@+id/encryptionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_round_unseen_msg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="E2E"
            android:textColor="@color/badge_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:contentDescription="End-to-end encryption active" />
    </LinearLayout>

    <!-- ============================================================
         Message Composer — pill-shaped, anchored at bottom
         ============================================================ -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/input_bar_background"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <!-- Attachment / Photo button -->
        <ImageButton
            android:id="@+id/attachmentButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/text"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Attach file"
            android:tint="@color/attachment_icon" />

        <!-- Message input (pill-shaped) -->
        <EditText
            android:id="@+id/inputMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_input_pill"
            android:gravity="start|center_vertical"
            android:hint="Type a message..."
            android:textColorHint="@color/input_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minLines="1"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="@color/input_text"
            android:textSize="15sp" />

        <!-- Send button (red circle) with inline progress -->
        <FrameLayout
            android:id="@+id/sendButtonContainer"
            android:layout_width="42dp"
            android:layout_height="42dp">

            <ImageView
                android:id="@+id/sendButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/sent"
                android:scaleType="centerInside"
                android:background="@drawable/bg_send_button"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:tint="@color/white"
                android:contentDescription="Send message" />

            <FrameLayout
                android:id="@+id/loadingContainer"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/sendProgressBar"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/primary_red" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
