<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ============================================================
         Top Bar — Back arrow + "Settings" title
         ============================================================ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/top_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_down"
            app:tint="@color/icon_tint"
            android:rotation="90"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:singleLine="true"
            android:text="Settings"
            android:textColor="@color/title_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            app:tint="@color/primary_red" />

    </LinearLayout>

    <!-- ============================================================
         Scrollable content
         ============================================================ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ====================================================
                 TRANSPORT MODE SECTION
                 ==================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRANSPORT MODE"
                android:textColor="@color/primary_red"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#2A2A2E"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/top_bar_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select how your messages are sent"
                        android:textColor="@color/peer_detail_text"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp" />

                    <RadioGroup
                        android:id="@+id/transportRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:checkedButton="@+id/rb_f2p_serverless">

                        <RadioButton
                            android:id="@+id/rb_f2p_serverless"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="F2P Serverless"
                            android:textColor="@color/transport_text"
                            android:buttonTint="@color/transport_button_tint"
                            android:textSize="15sp"
                            android:paddingVertical="8dp"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rb_sms_fallback"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/transport_sms"
                            android:textColor="@color/transport_text"
                            android:buttonTint="@color/transport_button_tint"
                            android:textSize="15sp"
                            android:paddingVertical="8dp" />

                        <RadioButton
                            android:id="@+id/rb_sosblue_mesh"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/transport_sosblue_mesh"
                            android:textColor="@color/transport_text"
                            android:buttonTint="@color/transport_button_tint"
                            android:textSize="15sp"
                            android:paddingVertical="8dp" />

                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ====================================================
                 NOTIFICATIONS SECTION
                 ==================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTIFICATIONS"
                android:textColor="@color/primary_red"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#2A2A2E"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/top_bar_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Chat notifications toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Direct Messages"
                                android:textColor="@color/title_text"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Notifications for 1:1 chat messages"
                                android:textColor="@color/peer_detail_text"
                                android:textSize="13sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchChatNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTintMode="src_atop"
                            app:trackTint="@color/primary_red" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#2A2A2E" />

                    <!-- News notifications toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="News Broadcasts"
                                android:textColor="@color/title_text"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Notifications for broadcast news items"
                                android:textColor="@color/peer_detail_text"
                                android:textSize="13sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchNewsNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:trackTint="@color/primary_red" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ====================================================
                 ABOUT SECTION
                 ==================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABOUT"
                android:textColor="@color/primary_red"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#2A2A2E"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/top_bar_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp">

                    <!-- App icon -->
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/nearby"
                        android:background="@drawable/circle_bg"
                        android:padding="12dp"
                        android:backgroundTint="@color/primary_red"
                        android:scaleType="centerInside"
                        app:tint="@color/white"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline-36"
                        android:textColor="@color/title_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline Mesh Messenger"
                        android:textColor="@color/peer_detail_text"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/textVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Version 1.0"
                        android:textColor="@color/icon_tint"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                    <View
                        android:layout_width="48dp"
                        android:layout_height="1dp"
                        android:background="#2A2A2E"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_about_desc"
                        android:textColor="@color/peer_detail_text"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:gravity="start" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Reset to defaults button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetDefaults"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Reset to Defaults"
                android:textColor="@color/icon_tint"
                app:cornerRadius="12dp"
                app:strokeColor="#2A2A2E"
                app:strokeWidth="1dp" />

            <!-- Bottom spacer for scroll -->
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
